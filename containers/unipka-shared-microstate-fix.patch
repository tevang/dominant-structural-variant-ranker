+        pending: dict,
+        emitted: dict,
+        microstate_to_smis: Dict[str, List[str]],
+        queued_microstates: set,
+        smi_to_names: Dict[str, List[str]],
+    ) -> Iterator[MolResult]:
+        """Compute forms of a fully predicted molecule, yield its results, free its bookkeeping."""
+        mol_state = pending.pop(parent)
